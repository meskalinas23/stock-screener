name: Backfill Screener Backtest

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  backfill:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install pandas yfinance matplotlib

      - name: Run backfill
        run: python backfill.py

      - name: Commit and push results
        run: |
          git config user.name "screener-bot"
          git config user.email "screener-bot@users.noreply.github.com"
          git add docs/ reports/
          git diff --quiet && git diff --staged --quiet || git commit -m "Backfill screener backtest"
          git fetch origin main
          git merge -X ours origin/main --no-edit || true
          git push
